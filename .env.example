APP_NAME="Etudiant Note App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=etudiant_note
DB_USERNAME=laravel
DB_PASSWORD=laravel_password

# -----------------------------------------------------------------------
# Bonne pratique DevSecOps : .env contient les vrais secrets (mots de passe,
# clés API) et NE DOIT JAMAIS être commité dans Git.
# Seul .env.example (sans valeurs sensibles) est versionné, il sert de
# modèle pour que chaque développeur crée son propre .env local.
# -----------------------------------------------------------------------
