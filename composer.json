{
    "name": "henry/etudiant-note-app",
    "type": "project",
    "description": "Application Etudiant/Note demonstrant DevOps et DevSecOps",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "fakerphp/faker": "^1.23"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
